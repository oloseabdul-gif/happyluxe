"use client";

import { useEffect, useState } from "react";

const slides = [
  {
    image: "/images/hero1.jpg",
    label: "THE HAPPYLUXE EDIT",
    title: "Tradition, beautifully reimagined.",
    text: "Discover statement pieces made for the way you live, celebrate, and express yourself.",
  },
  {
    image: "/images/hero2.jpg",
    label: "NEW SEASON",
    title: "Your style. Your story.",
    text: "Elevated fashion with a modern point of view and timeless details.",
  },
  {
    image: "/images/hero3.jpg",
    label: "MADE TO BE REMEMBERED",
    title: "Make every moment yours.",
    text: "Find the looks that bring confidence to every occasion.",
  },
  {
    image: "/images/hero4.jpg",
    label: "CURATED FOR YOU",
    title: "A little more extraordinary.",
    text: "Fresh silhouettes, beautiful textures, and effortless elegance.",
  },
  {
    image: "/images/hero5.jpg",
    label: "HAPPYLUXE SIGNATURE",
    title: "Wear what feels like you.",
    text: "Explore pieces that celebrate individuality and personal style.",
  },
  {
    image: "/images/hero6.jpg",
    label: "THE COLLECTION",
    title: "Step into something lovely.",
    text: "Discover your next favorite look, thoughtfully selected.",
  },
];

const collections = [
  {
    name: "Women",
    image: "/images/women.jpg",
    text: "Modern elegance, made personal.",
  },
  {
    name: "Men",
    image: "/images/men.jpg",
    text: "Everyday style with distinction.",
  },
  {
    name: "Handmade",
    image: "/images/handmade.jpg",
    text: "Crafted details, one of a kind.",
  },
];

export default function Home() {
  const [active, setActive] = useState(0);
  const [menuOpen, setMenuOpen] = useState(false);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loaderTimer = window.setTimeout(() => {
      setLoading(false);
    }, 2400);

    return () => window.clearTimeout(loaderTimer);
  }, []);

  useEffect(() => {
    const timer = window.setInterval(() => {
      setActive((current) => (current + 1) % slides.length);
    }, 5000);

    return () => window.clearInterval(timer);
  }, []);

  const previous = () => {
    setActive((current) => (current - 1 + slides.length) % slides.length);
  };

  const next = () => {
    setActive((current) => (current + 1) % slides.length);
  };

  return (
    <main className="site">
      {loading && (
        <div
          className="loader-screen"
          role="status"
          aria-label="Loading HAPPYLUXE"
        >
          <div className="loader-content">
            <div className="loader-mark">
              H<span>L</span><i>⌁</i>
            </div>
            <div className="loader-name">HAPPYLUXE</div>
            <div className="loader-tagline">
              WHERE TRADITION MEETS TREND
            </div>
            <div className="loader-line">
              <span />
            </div>
          </div>
        </div>
      )}

      <div className="announcement">
        A LITTLE LUXURY, A LOT OF YOU <span>✦</span> DISCOVER HAPPYLUXE
      </div>

      <header className="header">
        <button
          className="menu-toggle"
          aria-label="Toggle navigation"
          onClick={() => setMenuOpen(!menuOpen)}
        >
          ☰
        </button>

        <a className="brand" href="#home" aria-label="HAPPYLUXE home">
          <span className="brand-mark">
            H<span>L</span>
          </span>
          <span className="brand-name">HAPPYLUXE</span>
          <span className="brand-tag">WHERE TRADITION MEETS TREND</span>
        </a>

        <nav className={menuOpen ? "nav nav-open" : "nav"}>
          <a href="#home" onClick={() => setMenuOpen(false)}>Home</a>
          <a href="#collections" onClick={() => setMenuOpen(false)}>Collections</a>
          <a href="#story" onClick={() => setMenuOpen(false)}>Our Story</a>
          <a href="#contact" onClick={() => setMenuOpen(false)}>Contact</a>
        </nav>

        <div className="header-actions">
          <a href="#collections" aria-label="Explore collections">⌕</a>
          <a href="#contact" aria-label="Contact HAPPYLUXE">♡</a>
        </div>
      </header>

      <section className="hero" id="home">
        <div
          className="hero-track"
          style={{ transform: `translateX(-${active * 100}%)` }}
        >
          {slides.map((slide) => (
            <article
              className="hero-slide"
              key={slide.image}
              style={{ backgroundImage: `url("${slide.image}")` }}
            >
              <div className="hero-shade" />
              <div className="hero-content">
                <p className="eyebrow">{slide.label}</p>
                <h1>{slide.title}</h1>
                <p className="hero-copy">{slide.text}</p>
                <a className="button button-light" href="#collections">
                  Explore collection <span>↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <button
          className="slider-arrow prev"
          onClick={previous}
          aria-label="Previous slide"
        >
          ‹
        </button>

        <button
          className="slider-arrow next"
          onClick={next}
          aria-label="Next slide"
        >
          ›
        </button>

        <div className="slider-dots">
          {slides.map((slide, index) => (
            <button
              key={slide.image}
              className={index === active ? "dot active" : "dot"}
              aria-label={`Go to slide ${index + 1}`}
              aria-current={index === active}
              onClick={() => setActive(index)}
            />
          ))}
        </div>

        <div className="hero-count">
          <strong>{String(active + 1).padStart(2, "0")}</strong>
          <span> / {String(slides.length).padStart(2, "0")}</span>
        </div>
      </section>

      <section className="intro">
        <p className="eyebrow pink">THE WORLD OF HAPPYLUXE</p>
        <h2>Find your kind of <em>beautiful.</em></h2>
        <p>
          Thoughtfully chosen fashion and handmade treasures that bring your
          individuality to life.
        </p>
      </section>

      <section className="collections section-wrap" id="collections">
        <div className="section-heading">
          <div>
            <p className="eyebrow pink">SHOP YOUR STYLE</p>
            <h2>Explore our collections</h2>
          </div>
          <a className="text-link" href="#contact">
            View all collections <span>→</span>
          </a>
        </div>

        <div className="collection-grid">
          {collections.map((item, index) => (
            <a className="collection-card" href="#contact" key={item.name}>
              <div className="collection-image">
                <img src={item.image} alt={`${item.name} collection`} />
                <span className="collection-number">0{index + 1}</span>
                <span className="round-arrow">↗</span>
              </div>
              <div className="collection-info">
                <div>
                  <h3>{item.name}</h3>
                  <p>{item.text}</p>
                </div>
                <span className="collection-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section className="story" id="story">
        <div className="story-image">
          <img
            src="/images/style-it-yourself.jpg"
            alt="HAPPYLUXE style inspiration"
          />
        </div>
        <div className="story-copy">
          <p className="eyebrow pink">OUR PHILOSOPHY</p>
          <h2>
            Style is how you tell the world <em>who you are.</em>
          </h2>
          <p>
            At HAPPYLUXE, we believe the most memorable style feels
            unmistakably yours. We bring together contemporary expression,
            cultural inspiration, and details worth keeping.
          </p>
          <a className="button button-pink" href="#contact">
            Discover our story <span>↗</span>
          </a>
        </div>
      </section>

      <section className="newsletter" id="contact">
        <p className="eyebrow">A NOTE FROM HAPPYLUXE</p>
        <h2>Let a little lovely into your inbox.</h2>
        <p>New arrivals, styling inspiration, and updates from our world.</p>
        <a className="button button-light" href="mailto:hello@happyluxe.com">
          Get in touch <span>↗</span>
        </a>
      </section>

      <footer>
        <a className="footer-brand" href="#home">HAPPYLUXE</a>
        <p>Where tradition meets trend.</p>
        <span>© {new Date().getFullYear()} HAPPYLUXE. All rights reserved.</span>
      </footer>

      <style jsx global>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');

        :root {
          --pink: #d92f78;
          --pink-dark: #a91d59;
          --blush: #fff4f8;
          --ink: #271b22;
          --muted: #76666e;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
          margin: 0;
          background: #fff;
          color: var(--ink);
          font-family: 'DM Sans', sans-serif;
        }
        a { color: inherit; text-decoration: none; }
        button { font: inherit; cursor: pointer; }
        .site { overflow: hidden; }

        /* HAPPYLUXE loader */
        .loader-screen {
          position: fixed;
          inset: 0;
          z-index: 9999;
          display: flex;
          align-items: center;
          justify-content: center;
          background: #fff;
          animation: loaderFade .45s ease 1.95s forwards;
        }
        .loader-content {
          text-align: center;
          animation: loaderRise .8s ease both;
        }
        .loader-mark {
          font-family: 'Playfair Display', serif;
          font-size: 76px;
          font-weight: 600;
          letter-spacing: -15px;
          padding-right: 15px;
          color: #d92f78;
          line-height: 1.1;
          position: relative;
        }
        .loader-mark span {
          color: #a91d59;
          font-style: italic;
        }
        .loader-mark i {
          font-family: serif;
          font-size: 25px;
          font-style: normal;
          letter-spacing: 0;
          position: absolute;
          right: calc(50% - 57px);
          bottom: 0;
          color: #e89bb9;
        }
        .loader-name {
          margin-top: 12px;
          font-size: 17px;
          font-weight: 700;
          letter-spacing: .3em;
          color: #271b22;
        }
        .loader-tagline {
          margin-top: 9px;
          font-size: 8px;
          letter-spacing: .18em;
          color: #a17d8e;
        }
        .loader-line {
          width: 120px;
          height: 2px;
          margin: 28px auto 0;
          background: #f7dce7;
          overflow: hidden;
        }
        .loader-line span {
          display: block;
          width: 40%;
          height: 100%;
          background: #d92f78;
          animation: loaderProgress 1.8s ease-in-out infinite;
        }
        @keyframes loaderProgress {
          from { transform: translateX(-110%); }
          to { transform: translateX(360%); }
        }
        @keyframes loaderRise {
          from { opacity: 0; transform: translateY(12px); }
          to { opacity: 1; transform: translateY(0); }
        }
        @keyframes loaderFade {
          to {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
          }
        }

        .announcement {
          min-height: 32px;
          padding: 7px 12px;
          background: var(--pink-dark);
          color: white;
          text-align: center;
          font-size: 9px;
          letter-spacing: .13em;
        }
        .announcement span { color: #ffc6dc; margin: 0 9px; }

        .header {
          height: 96px;
          padding: 0 6%;
          display: flex;
          align-items: center;
          justify-content: space-between;
          background: white;
          position: relative;
          z-index: 10;
          border-bottom: 1px solid #f6e8ee;
        }
        .brand {
          display: flex;
          flex-direction: column;
          align-items: center;
          line-height: 1;
        }
        .brand-mark {
          font-family: 'Playfair Display', serif;
          font-size: 36px;
          font-weight: 600;
          letter-spacing: -8px;
          color: var(--pink);
          padding-right: 8px;
        }
        .brand-mark span { color: #9f1e57; font-style: italic; }
        .brand-name {
          font-size: 13px;
          letter-spacing: .24em;
          font-weight: 700;
          margin-top: 5px;
        }
        .brand-tag {
          font-size: 6px;
          letter-spacing: .13em;
          color: #9d7d8c;
          margin-top: 5px;
        }
        .nav { display: flex; gap: 32px; font-size: 12px; font-weight: 600; }
        .nav a:hover { color: var(--pink); }
        .header-actions { display: flex; gap: 18px; }
        .header-actions a { font-size: 25px; }
        .menu-toggle {
          display: none;
          border: 0;
          background: none;
          font-size: 22px;
        }

        /* Horizontal hero carousel */
        .hero {
          height: min(690px, 68vw);
          min-height: 480px;
          position: relative;
          overflow: hidden;
          background: #351827;
          color: white;
        }
        .hero-track {
          display: flex;
          width: 100%;
          height: 100%;
          transition: transform 850ms cubic-bezier(.22,.61,.36,1);
          will-change: transform;
        }
        .hero-slide {
          flex: 0 0 100%;
          width: 100%;
          height: 100%;
          position: relative;
          background-position: center;
          background-size: cover;
          background-repeat: no-repeat;
        }
        .hero-shade {
          position: absolute;
          inset: 0;
          background: linear-gradient(
            90deg,
            rgba(40,15,29,.76) 0%,
            rgba(40,15,29,.45) 48%,
            rgba(40,15,29,.06) 100%
          );
        }
        .hero-content {
          position: absolute;
          left: 12%;
          top: 50%;
          transform: translateY(-50%);
          max-width: 570px;
          padding: 20px;
        }
        .eyebrow {
          font-size: 10px;
          letter-spacing: .23em;
          font-weight: 700;
          margin: 0 0 20px;
        }
        .hero .eyebrow { color: #ffc5dc; }
        .hero h1 {
          font-family: 'Playfair Display', serif;
          font-size: clamp(42px, 5.4vw, 76px);
          font-weight: 500;
          letter-spacing: -.035em;
          line-height: 1.07;
          margin: 0 0 22px;
        }
        .hero-copy {
          font-size: 14px;
          line-height: 1.9;
          max-width: 420px;
          color: #f5eaf0;
          margin: 0 0 31px;
        }
        .button {
          display: inline-flex;
          align-items: center;
          gap: 24px;
          padding: 16px 23px;
          font-size: 10px;
          letter-spacing: .08em;
          text-transform: uppercase;
          font-weight: 700;
          transition: transform .2s, background .2s;
        }
        .button:hover { transform: translateY(-2px); }
        .button-light { background: white; color: var(--pink-dark); }
        .button span { font-size: 16px; }

        .slider-arrow {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          width: 44px;
          height: 44px;
          border: 1px solid #ffffff90;
          border-radius: 50%;
          background: #ffffff18;
          color: white;
          font-size: 30px;
          line-height: 1;
          z-index: 2;
        }
        .slider-arrow:hover { background: white; color: var(--pink); }
        .prev { left: 28px; }
        .next { right: 28px; }
        .slider-dots {
          position: absolute;
          left: 12%;
          bottom: 34px;
          display: flex;
          gap: 9px;
          z-index: 2;
        }
        .dot {
          width: 22px;
          height: 3px;
          padding: 0;
          border: 0;
          background: #ffffff80;
          transition: width .3s, background .3s;
        }
        .dot.active { width: 42px; background: white; }
        .hero-count {
          position: absolute;
          right: 6%;
          bottom: 29px;
          font-size: 10px;
          letter-spacing: .14em;
          color: #ffffffb0;
          z-index: 2;
        }
        .hero-count strong { color: white; }

        .pink { color: var(--pink); }
        .intro {
          text-align: center;
          padding: 88px 20px 65px;
          background: linear-gradient(#fff, #fffafd);
        }
        .intro h2,
        .section-heading h2,
        .story h2,
        .newsletter h2 {
          font-family: 'Playfair Display', serif;
          font-weight: 500;
          letter-spacing: -.035em;
        }
        .intro h2 { font-size: clamp(32px, 4vw, 49px); margin: 0 0 15px; }
        .intro h2 em,
        .story h2 em { color: var(--pink); font-weight: 500; }
        .intro > p:last-child {
          font-size: 13px;
          color: var(--muted);
          line-height: 1.8;
          max-width: 510px;
          margin: auto;
        }

        .section-wrap {
          max-width: 1320px;
          margin: auto;
          padding: 25px 6% 100px;
        }
        .section-heading {
          display: flex;
          align-items: end;
          justify-content: space-between;
          margin-bottom: 32px;
        }
        .section-heading .eyebrow { margin-bottom: 10px; }
        .section-heading h2 { font-size: 36px; margin: 0; }
        .text-link { font-size: 11px; font-weight: 700; padding-bottom: 6px; }
        .text-link span { color: var(--pink); margin-left: 9px; }
        .collection-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 23px;
        }
        .collection-image {
          height: 410px;
          position: relative;
          overflow: hidden;
          background: var(--blush);
        }
        .collection-image img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform .7s;
        }
        .collection-card:hover img { transform: scale(1.045); }
        .collection-number {
          position: absolute;
          top: 18px;
          left: 18px;
          background: white;
          color: var(--pink);
          font-size: 10px;
          padding: 8px 10px;
        }
        .round-arrow {
          position: absolute;
          right: 17px;
          bottom: 17px;
          width: 42px;
          height: 42px;
          border-radius: 50%;
          background: white;
          display: grid;
          place-items: center;
          color: var(--pink);
          font-size: 18px;
        }
        .collection-info {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 19px 2px;
        }
        .collection-info h3 {
          font-family: 'Playfair Display', serif;
          font-size: 25px;
          font-weight: 500;
          margin: 0 0 6px;
        }
        .collection-info p { font-size: 11px; color: var(--muted); margin: 0; }
        .collection-arrow { font-size: 21px; color: var(--pink); }

        .story {
          display: grid;
          grid-template-columns: 1fr 1fr;
          background: var(--blush);
          min-height: 520px;
        }
        .story-image { min-height: 520px; }
        .story-image img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
        .story-copy {
          align-self: center;
          padding: 70px 12%;
          max-width: 650px;
        }
        .story h2 {
          font-size: clamp(34px, 4vw, 51px);
          line-height: 1.17;
          margin: 0 0 22px;
        }
        .story-copy > p:not(.eyebrow) {
          font-size: 13px;
          line-height: 2;
          color: var(--muted);
          margin: 0 0 27px;
        }
        .button-pink { background: var(--pink); color: white; }
        .button-pink:hover { background: var(--pink-dark); }

        .newsletter {
          text-align: center;
          padding: 80px 20px;
          background: linear-gradient(120deg, #c8266c, #e75b96);
          color: white;
        }
        .newsletter .eyebrow { color: #ffd7e7; margin-bottom: 15px; }
        .newsletter h2 { font-size: clamp(31px, 4vw, 46px); margin: 0 0 13px; }
        .newsletter > p:not(.eyebrow) {
          font-size: 13px;
          color: #ffe7f0;
          margin: 0 0 25px;
        }
        .newsletter .button { background: white; color: var(--pink-dark); }

        footer {
          text-align: center;
          padding: 35px 20px 25px;
          background: white;
        }
        .footer-brand {
          font-family: 'Playfair Display', serif;
          letter-spacing: .2em;
          font-size: 18px;
          color: var(--pink);
          font-weight: 700;
        }
        footer p {
          font-family: 'Playfair Display', serif;
          font-style: italic;
          color: #9c7e8b;
          font-size: 13px;
          margin: 7px 0 20px;
        }
        footer span { font-size: 9px; letter-spacing: .08em; color: #a18b95; }

        @media (max-width: 850px) {
          .header { padding: 0 5%; }
          .nav { gap: 18px; }
          .hero { height: 620px; min-height: 0; }
          .hero-content { left: 7%; right: 7%; }
          .collection-image { height: 320px; }
          .story-copy { padding: 50px 9%; }
        }

        @media (max-width: 620px) {
          .announcement { font-size: 8px; letter-spacing: .06em; }
          .header { height: 76px; }
          .menu-toggle { display: block; }
          .brand-mark { font-size: 30px; }
          .brand-name { font-size: 11px; }
          .brand-tag { font-size: 5px; }
          .nav {
            display: none;
            position: absolute;
            top: 76px;
            left: 0;
            right: 0;
            background: white;
            padding: 22px 7%;
            box-shadow: 0 12px 18px #55213a12;
            flex-direction: column;
            gap: 20px;
          }
          .nav.nav-open { display: flex; }
          .header-actions { gap: 10px; }
          .header-actions a { font-size: 22px; }
          .hero { height: 590px; }
          .hero-slide { background-position: 58% center; }
          .hero-shade {
            background: linear-gradient(
              90deg,
              rgba(40,15,29,.76),
              rgba(40,15,29,.28)
            );
          }
          .hero-content { left: 5%; right: 5%; top: 47%; padding: 10px; }
          .hero h1 { font-size: 43px; }
          .hero-copy { font-size: 12px; max-width: 310px; }
          .slider-arrow { width: 34px; height: 34px; font-size: 24px; }
          .prev { left: 12px; }
          .next { right: 12px; }
          .slider-dots { left: 8%; bottom: 25px; }
          .hero-count { right: 8%; bottom: 23px; }
          .intro { padding: 65px 23px 45px; }
          .intro h2 { font-size: 34px; }
          .section-wrap { padding: 20px 5% 65px; }
          .section-heading {
            align-items: start;
            gap: 15px;
            flex-direction: column;
          }
          .section-heading h2 { font-size: 30px; }
          .collection-grid { grid-template-columns: 1fr; gap: 20px; }
          .collection-image { height: 420px; }
          .collection-info { padding: 15px 2px; }
          .story { grid-template-columns: 1fr; }
          .story-image { min-height: 350px; height: 350px; }
          .story-copy { padding: 45px 7% 55px; }
          .story h2 { font-size: 38px; }
          .newsletter { padding: 65px 20px; }
          .newsletter h2 { font-size: 34px; }
        }
      `}</style>
    </main>
  );
}
